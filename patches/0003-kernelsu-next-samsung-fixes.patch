@@ -203,6 +205,18 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 			return 0;
 	}
 
+	if (magic2 == CHANGE_UAPIVER) {
+		// only root is allowed for this command
+		if (current_uid().val != 0)
+			return 0;
