diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
index 92724041..6d45c8ed 100644
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -65,7 +65,23 @@ static int do_get_info(void __user *arg)
         cmd.flags |= KSU_GET_INFO_FLAG_LATE_LOAD;
     }
     cmd.features = KSU_FEATURE_MAX;
-    cmd.uapi_version = KERNEL_SU_UAPI_VERSION;
+
+    /* Dynamic UAPI resolution:
+     * 1. If caller provides an expected/requested UAPI version (4..16), match it.
+     * 2. If runtime override was set (via sys_reboot supercall CHANGE_UAPIVER or ksu.uapi= cmdline), use it.
+     * 3. Fall back to compiled default KERNEL_SU_UAPI_VERSION.
+     */
+    {
+        struct ksu_get_info_cmd in_cmd = {0};
+        if (!copy_from_user(&in_cmd, arg, sizeof(in_cmd)) &&
+            in_cmd.uapi_version >= 4 && in_cmd.uapi_version <= 16) {
+            cmd.uapi_version = in_cmd.uapi_version;
+        } else if (ksu_uapi_override) {
+            cmd.uapi_version = ksu_uapi_override;
+        } else {
+            cmd.uapi_version = KERNEL_SU_UAPI_VERSION;
+        }
+    }
 
     if (copy_to_user(arg, &cmd, sizeof(cmd))) {
         pr_err("get_version: copy_to_user failed\n");
