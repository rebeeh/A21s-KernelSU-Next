diff --git a/kernel/feature/susfs.c b/kernel/feature/susfs.c
new file mode 100644
index 00000000..c39daf0a
--- /dev/null
+++ b/kernel/feature/susfs.c
@@ -0,0 +1,449 @@
+#include <linux/version.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/fs.h>
+#include <linux/namei.h>
+#include <linux/path.h>
+#include <linux/sched.h>
+#include <linux/cred.h>
+#include <linux/uaccess.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/mount.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 17, 0)
+#include <linux/syscalls.h>
+#endif
+#include <linux/susfs.h>
+#include <linux/susfs_def.h>
+
+#include "compat/kernel_compat.h"
+#include "selinux/selinux.h"
+#include "klog.h"
+#include "susfs.h"
+
+#ifdef CONFIG_KSU_SUSFS
+
+#define SUSFS_MAGIC 0xFAFAFAFA
+#define SUSFS_MAX_VERSION_BUFSIZE 16
+#define SUSFS_MAX_VARIANT_BUFSIZE 16
+#define SUSFS_ENABLED_FEATURES_SIZE 8192
+
+struct st_susfs_version {
+	char susfs_version[SUSFS_MAX_VERSION_BUFSIZE];
+	int err;
+};
+
+struct st_susfs_variant {
+	char susfs_variant[SUSFS_MAX_VARIANT_BUFSIZE];
+	int err;
+};
+
+struct st_susfs_enabled_features {
+	char enabled_features[SUSFS_ENABLED_FEATURES_SIZE];
+	int err;
+};
+
+/* Domain checks for SUSFS */
+bool susfs_is_current_ksu_domain(void)
+{
+	return is_ksu_domain();
+}
+
+bool susfs_is_current_zygote_domain(void)
+{
+	return is_zygote(current_cred());
+}
+
+bool susfs_is_current_init_domain(void)
+{
+	return is_init(current_cred());
+}
+
+u32 susfs_get_current_sid(void)
+{
+	return current_sid();
+}
+
+/* Post-fs-data configuration */
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+static bool susfs_is_umount_for_zygote_system_process_enabled = false;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+extern bool susfs_is_auto_add_sus_bind_mount_enabled;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+extern bool susfs_is_auto_add_sus_ksu_default_mount_enabled;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+extern bool susfs_is_auto_add_try_umount_for_bind_mount_enabled;
+#endif
+
+void susfs_on_post_fs_data(void)
+{
+	struct path path;
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	if (!kern_path(DATA_ADB_UMOUNT_FOR_ZYGOTE_SYSTEM_PROCESS, 0, &path)) {
+		susfs_is_umount_for_zygote_system_process_enabled = true;
+		path_put(&path);
+	}
+	pr_info("susfs_is_umount_for_zygote_system_process_enabled: %d\n", susfs_is_umount_for_zygote_system_process_enabled);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	if (!kern_path(DATA_ADB_NO_AUTO_ADD_SUS_BIND_MOUNT, 0, &path)) {
+		susfs_is_auto_add_sus_bind_mount_enabled = false;
+		path_put(&path);
+	}
+	pr_info("susfs_is_auto_add_sus_bind_mount_enabled: %d\n", susfs_is_auto_add_sus_bind_mount_enabled);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	if (!kern_path(DATA_ADB_NO_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT, 0, &path)) {
+		susfs_is_auto_add_sus_ksu_default_mount_enabled = false;
+		path_put(&path);
+	}
+	pr_info("susfs_is_auto_add_sus_ksu_default_mount_enabled: %d\n", susfs_is_auto_add_sus_ksu_default_mount_enabled);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+	if (!kern_path(DATA_ADB_NO_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT, 0, &path)) {
+		susfs_is_auto_add_try_umount_for_bind_mount_enabled = false;
+		path_put(&path);
+	}
+	pr_info("susfs_is_auto_add_try_umount_for_bind_mount_enabled: %d\n", susfs_is_auto_add_try_umount_for_bind_mount_enabled);
+#endif
+}
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid)
+{
+	struct path path;
+	int err = kern_path(mnt, 0, &path);
+	if (err)
+		return;
+	if (check_mnt && path.dentry != path.mnt->mnt_root) {
+		path_put(&path);
+		return;
+	}
+	path_put(&path);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 17, 0)
+	{
+		mm_segment_t old_fs = get_fs();
+		set_fs(KERNEL_DS);
+		ksys_umount((char __user *)mnt, flags);
+		set_fs(old_fs);
+	}
+#endif
+}
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+void susfs_try_umount_all(uid_t uid)
+{
+	susfs_try_umount(uid);
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	ksu_try_umount("/system", true, 0, uid);
+	ksu_try_umount("/system_ext", true, 0, uid);
+	ksu_try_umount("/vendor", true, 0, uid);
+	ksu_try_umount("/product", true, 0, uid);
+	ksu_try_umount("/odm", true, 0, uid);
+	ksu_try_umount("/data/adb/modules", false, MNT_DETACH, uid);
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+	ksu_try_umount("/debug_ramdisk", true, MNT_DETACH, uid);
+#endif
+#endif
+}
+#endif
+
+/* Build newline-delimited list of enabled features for ksud */
+static void get_enabled_features_string(char *buf, size_t buf_size)
+{
+	buf[0] = '\0';
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	strlcat(buf, "CONFIG_KSU_SUSFS_SUS_PATH\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_SUS_MOUNT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	strlcat(buf, "CONFIG_KSU_SUSFS_SUS_KSTAT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+	strlcat(buf, "CONFIG_KSU_SUSFS_SUS_OVERLAYFS\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_TRY_UMOUNT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	strlcat(buf, "CONFIG_KSU_SUSFS_SPOOF_UNAME\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	strlcat(buf, "CONFIG_KSU_SUSFS_ENABLE_LOG\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	strlcat(buf, "CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	strlcat(buf, "CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	strlcat(buf, "CONFIG_KSU_SUSFS_OPEN_REDIRECT\n", buf_size);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+	strlcat(buf, "CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT\n", buf_size);
+#endif
+}
+
+static u64 get_enabled_features_bitmask(void)
+{
+	u64 feat = 0;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	feat |= (1ULL << 0);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	feat |= (1ULL << 1);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	feat |= (1ULL << 2);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	feat |= (1ULL << 3);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	feat |= (1ULL << 4);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+	feat |= (1ULL << 5);
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	feat |= (1ULL << 6);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+	feat |= (1ULL << 7);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	feat |= (1ULL << 8);
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	feat |= (1ULL << 9);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	feat |= (1ULL << 10);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	feat |= (1ULL << 11);
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	feat |= (1ULL << 12);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+	feat |= (1ULL << 14);
+#endif
+	return feat;
+}
+
+/* Handler for prctl(0xDEADBEEF, cmd, arg3, arg4, arg5) from ksu_susfs tool */
+int ksu_handle_prctl(int option, unsigned long arg2, unsigned long arg3,
+		     unsigned long arg4, unsigned long arg5)
+{
+	int error = 0;
+
+	if (current_uid().val != 0)
+		return 0;
+
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	if (arg2 == CMD_SUSFS_ADD_SUS_PATH) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_path)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_path((struct st_susfs_sus_path __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	if (arg2 == CMD_SUSFS_ADD_SUS_MOUNT) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_mount)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_mount((struct st_susfs_sus_mount __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	if (arg2 == CMD_SUSFS_ADD_SUS_KSTAT || arg2 == CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_kstat)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_kstat((struct st_susfs_sus_kstat __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	if (arg2 == CMD_SUSFS_UPDATE_SUS_KSTAT) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_kstat)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_update_sus_kstat((struct st_susfs_sus_kstat __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	if (arg2 == CMD_SUSFS_ADD_TRY_UMOUNT) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_try_umount)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_try_umount((struct st_susfs_try_umount __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	if (arg2 == CMD_SUSFS_RUN_UMOUNT_FOR_CURRENT_MNT_NS) {
+		susfs_try_umount(current_uid().val);
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	if (arg2 == CMD_SUSFS_SET_UNAME) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_uname)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_uname((struct st_susfs_uname __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	if (arg2 == CMD_SUSFS_ENABLE_LOG) {
+		if (arg3 == 0 || arg3 == 1) {
+			susfs_set_log((bool)arg3);
+		}
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	if (arg2 == CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG) {
+		if (!ksu_access_ok((void __user *)arg3, SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_cmdline_or_bootconfig((char __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	if (arg2 == CMD_SUSFS_ADD_OPEN_REDIRECT) {
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_open_redirect)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_open_redirect((struct st_susfs_open_redirect __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+#endif
+	if (arg2 == CMD_SUSFS_SHOW_VERSION) {
+		char *ver = SUSFS_VERSION;
+		size_t len = strlen(ver) + 1;
+		if (!ksu_access_ok((void __user *)arg3, len))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, ver, len);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	if (arg2 == CMD_SUSFS_SHOW_ENABLED_FEATURES) {
+		u64 bitmask = get_enabled_features_bitmask();
+		if (!ksu_access_ok((void __user *)arg3, sizeof(bitmask)))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, &bitmask, sizeof(bitmask));
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	if (arg2 == CMD_SUSFS_SHOW_VARIANT) {
+		char *variant = SUSFS_VARIANT;
+		size_t len = strlen(variant) + 1;
+		if (!ksu_access_ok((void __user *)arg3, len))
+			return 0;
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, variant, len);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_warn("susfs: copy_to_user failed\n");
+		return 0;
+	}
+
+	return 0;
+}
+
+/* Handler for syscall(SYS_reboot, 0xDEADBEEF, 0xFAFAFAFA, cmd, payload) from ksud */
+int ksu_handle_susfs_sys_reboot(int magic1, int magic2, unsigned int cmd,
+				void __user **arg)
+{
+	if (current_uid().val != 0)
+		return 0;
+
+	if (cmd == CMD_SUSFS_SHOW_VERSION) {
+		struct st_susfs_version info;
+		memset(&info, 0, sizeof(info));
+		strscpy(info.susfs_version, SUSFS_VERSION, sizeof(info.susfs_version));
+		info.err = 0;
+		if (copy_to_user((void __user *)*arg, &info, sizeof(info)))
+			pr_warn("susfs: reboot show_version copy_to_user failed\n");
+		return 0;
+	}
+
+	if (cmd == CMD_SUSFS_SHOW_VARIANT) {
+		struct st_susfs_variant info;
+		memset(&info, 0, sizeof(info));
+		strscpy(info.susfs_variant, SUSFS_VARIANT, sizeof(info.susfs_variant));
+		info.err = 0;
+		if (copy_to_user((void __user *)*arg, &info, sizeof(info)))
+			pr_warn("susfs: reboot show_variant copy_to_user failed\n");
+		return 0;
+	}
+
+	if (cmd == CMD_SUSFS_SHOW_ENABLED_FEATURES) {
+		struct st_susfs_enabled_features *info = kzalloc(sizeof(*info), GFP_KERNEL);
+		if (!info)
+			return 0;
+		get_enabled_features_string(info->enabled_features, sizeof(info->enabled_features));
+		info->err = 0;
+		if (copy_to_user((void __user *)*arg, info, sizeof(*info)))
+			pr_warn("susfs: reboot show_features copy_to_user failed\n");
+		kfree(info);
+		return 0;
+	}
+
+	return 0;
+}
