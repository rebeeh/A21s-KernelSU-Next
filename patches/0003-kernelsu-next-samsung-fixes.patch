+
+		if (copy_to_user((void __user *)*arg, &reply, sizeof(reply)))
+			return 0;
+	}
+
 	// WARNING!!! triple ptr zone! ***
 	// https://wiki.c2.com/?ThreeStarProgrammer
 	if (magic2 == CHANGE_SPOOF_UNAME) {
