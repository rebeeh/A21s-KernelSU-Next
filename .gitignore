# ==============================================================================
# Git Ignore Configuration for A21s KernelSU-Next
# ==============================================================================

# Build Outputs & Flashable Images
out/
build/
*.img
*.tar
*.tar.gz
*.tar.md5
*.zip
*.log
*.tmp
boot.img

# Stock Boot Images & Local Backups
stock/
*.stock.*

# External Prebuilts & Toolchains
toolchain/
tools/magiskboot

# Cloned Kernel Source Tree (when building locally)
a21s-kernel/
KernelSU-Next/

# Linux Kernel Build Artifacts
*.o
*.o.*
*.ko
*.obj
*.elf
*.d
*.cmd
.tmp_versions/
modules.order
Module.symvers
vmlinux
vmlinux.o
System.map
arch/arm64/boot/Image
arch/arm64/boot/Image.gz
arch/arm64/boot/dts/**/*.dtb

# Editor & IDE configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# OS-generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.venv/
venv/
env/

# PIT & Samsung Firmware Partitions
*.pit

# Diagnostic Logs & Crash Dumps
*.pstore
*.patch
*.diff
